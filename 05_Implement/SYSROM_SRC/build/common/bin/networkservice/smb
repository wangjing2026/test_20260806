# startup code for everything
start_samba() {
	kdestroy
	#check if samba is already running
	Join_Status=`cat ${SAMBA_CONF_DIR}/smb.conf  |grep "security" | awk -F "="  '{ print $2 }'`
	echo $Join_Status
	PID=`pidof -s smbd`
	if [ $PID ]; then
		echo "samba is already running!!!"
		COUNT=0 
		while [ "$PID" != "" ] 
		do
			if test $COUNT -le 10
			then
				echo "$COUNT Waiting for smbd shutdown"
				PID=`pidof -s smbd`
				if [ $PID ]; then
					killall -v smbd
					killall -v nmbd
				#	killall -v winbindd
					((COUNT=COUNT+1))
					sleep 1
					else
					break
				fi
			else
				break
			fi
		done
	fi
	
	#update_netbios_name
	echo -n "Starting samba ..."
	${SAMBA_BIN}/nmbd -s ${SAMBA_CONF_DIR}/smb.conf -D
	${SAMBA_BIN}/smbd -s ${SAMBA_CONF_DIR}/smb.conf -D
#	if [ x"$Join_Status" != x"user" ]; then
#		echo "Starting winbindd..."
#		${SAMBA_BIN}/winbindd -s ${SAMBA_CONF_DIR}/smb.conf -D
#	else
#		echo "Not Starting winbindd..."
#	fi	
}

