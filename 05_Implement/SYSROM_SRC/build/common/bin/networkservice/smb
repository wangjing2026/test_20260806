#return samba to share
set_samba_as_share(){
	sed -i -e '/security=/ c\security=user' ${SAMBA_CONF_DIR}/smb.conf
	sed -i -e '/workgroup=/ c\workgroup=Workgroup' ${SAMBA_CONF_DIR}/smb.conf
	sed -i -e '/password server=/ c\password server=' ${SAMBA_CONF_DIR}/smb.conf
	sed -i -e '/map to guest=/ c\map to guest=bad user' ${SAMBA_CONF_DIR}/smb.conf
	sed -i -e '/realm=/ c\realm=' ${SAMBA_CONF_DIR}/smb.conf
	DOMAIN_NNAME=`grep "workgroup" ${SMB_CONF_FILE} | awk -F"=" '{ print $2 }'`
	echo "Status-------> Writing workgroup info for share $DOMAIN_NNAME to panel"
	${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/currentStatus ${DOMAIN_NNAME}&
	${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/adsName workgroup &
}

# code for domain join
domain_join() { 
	echo -n 'starting samba  service '
	domainJoin=`echo $2|cut -c3`
	#echo $domainJoin $1 $2 $3
	echo "Joining domain specified in smb.conf"
	
	#To join NT domain, set security=domain in smb.conf
	if [ -z $3 ] || [ -z $4 ];then
		echo "No username and password argument is supplied"
		return 1
	else
		username=`echo $3|cut -c3-`
		password=`echo $4|cut -c3-`
		UP="$username%$password"
	fi
	#echo $username
	#echo $password
	#echo $UP
	if [ -z $username ]
	then
		echo -n "Empty/Invalid username NT domain....."
		echo -n "Could not join the NT domain because the username is empty"
		return 1
	else
		echo "Valid username for NT domain"
	fi

	if [ -z $password ]
	then
		echo -n "Empty/Invalid password for  NT domain ....."
		echo -n "Could not join the NT domain because the password is empty"
		return 1
	else
		echo -n "Valid password for  NT domain"
	fi

	# set security=domain in smb.conf
	sed -i -e '/security=/ c\security=domain' ${SAMBA_CONF_DIR}/smb.conf
	sed -i -e '/map to guest=/ c\map to guest=bad uid' ${SAMBA_CONF_DIR}/smb.conf
	DOMAIN_NNAME=`grep "realm" ${SMB_CONF_FILE} | awk -F"=" '{ print $2 }'| awk -F"." '{ print $1 }'`
	unlink ${SAMBA_CONF_DIR}/lmhosts
	${SAMBA_BIN}/net ads lookup -U$UP -s ${SAMBA_CONF_DIR}/smb.conf > ${SAMBA_CONF_DIR}/lmhosts
	NetBIOS=`cat ${SAMBA_CONF_DIR}/lmhosts  |grep -e "Pre-Win2k Hostname" |  cut -d ':' -f2`
	echo $NetBIOS > ${SAMBA_CONF_DIR}/lmhosts
	echo $NetBIOS

	if [ "$NetBIOS" == "" ];
	then
                echo "Status-------> NT Domain joined failed...INVALID Domain Name"
                return 1;
        fi

	echo "${SAMBA_BIN}/net rpc join..."
	`${SAMBA_BIN}/net rpc join -U$UP  -s ${SAMBA_CONF_DIR}/smb.conf 2>&1 | tee  ${KERBEROS_STATUS}`
#	ret_rpc=`cat ${KERBEROS_STATUS} |grep "Joined domain " | awk -F " "  '{ print $3 }'| awk -F "."  '{ print $1 }'` > /dev/null
    ret_rpc=`cat ${KERBEROS_STATUS} |grep "Using short domain name --" | awk -F " "  '{ print $6 }'| awk -F "."  '{ print $1 }'` > /dev/null
	echo "Exiting DOMAIN JOIN() = $ret_rpc and domain name = $DOMAIN_NNAME "
	unlink ${KERBEROS_STATUS}
	if [ x"$ret_rpc" == x"$DOMAIN_NNAME" ];
	then
		echo "Status-------> NT Domain joined success, setting $DOMAIN_NNAME to panel"
		DOMAIN_NNAME=`grep "realm" ${SMB_CONF_FILE} | awk -F"=" '{ print $2 }'`
		${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/currentStatus ${DOMAIN_NNAME}&
		${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/adsName domain &
		return 0
	else
		echo "Status-------> NT Domain joined failed"
		return 1
	fi
}

#code for AD Join
ad_join() {
	echo "Joining AD domain specified in smb.conf"
	#To join AD domain, set security=ADS in smb.conf
	###	${SAMBA_BIN}/kdestroy   ### for testing IPV6 join,,,dont delet it.
		
	if [ -z $3 ] || [ -z $4 ];then
		echo "No username and password argument is supplied for NT domain "
		return 1
	else
		username=`echo $3|cut -c3-`
		password=`echo $4|cut -c3-`
		UP="$username%$password"
	fi
	
	#echo $username
	#echo $password
	#echo $UP
	if [ -z $username ]
	then
		echo -n "Empty/Invalid username....."
		echo -n "Could not AD join the domain because the username is empty"
		return 1
	else
		echo "Valid username for AD domain Join"
	fi
	if [ -z $password ]
	then
		echo -n "Empty/Invalid password for AD Domain....."
		echo -n "Could not join the domain because the password is empty"
		return 1
	else
		echo -n "Valid password for AD domain"
	fi
		
	realm1=`grep realm= ${SAMBA_CONF_DIR}/smb.conf | cut -f2 -d=` 

	# set security=ADS in smb.conf     	 ##Set the "map ro guest=bad uid" parameter in SMB.CONF
	sed -i -e '/security=/ c\security=ADS' ${SAMBA_CONF_DIR}/smb.conf
	sed -i -e '/map to guest=/ c\map to guest=bad uid' ${SAMBA_CONF_DIR}/smb.conf
              

	# synchronize time with the AD domain controller
	org_date=`date`
	#dc_ip=$(grep "password server" ${SAMBA_CONF_DIR}/smb.conf | cut -d= -f2)
	#ntpdate $dc_ip

	#kdestroy 
	# echo $password |kinit --password-file=STDIN $username@$realm1 
	iter=0
	while [ 1 ]
	do
		ERR=`echo $password | kinit --password-file=STDIN $username@$realm1 2>&1`
		#realm_name(TO UPPER) done at smbnmo.cpp itself
		ret=$?
		echo "KINIT_ADS returns -->$ret"
		if test $ret -ne "0";then
			if test $iter -le 10
			then
				#ERR=`echo $password | kinit --password-file=STDIN $username@$realm1 2>&1`
				echo "kinit outputs -> $ERR"
				Revoke_ErrorPattern1="Clients credentials"
				Revoke_ErrorPattern2=" revoked" # Clients credentials have been revoked
				val0=`echo $ERR|grep -s $Revoke_ErrorPattern1` 
				val00=`echo $ERR| grep -s $Revoke_ErrorPattern2`
				#kinit: krb5_get_init_creds: Clients credentials have been revoked
				if [ x"$val0" != x"" -o x"$val00" != x"" ];then
					echo "Client Credentials revoked from AD server"
					##Returning the error no.18 as per Kerberos v5 library error code table.
						
					return $KRB5KDC_ERR_CLIENT_REVOKED
				fi
				
				passwd_ErrorPattern="incorrect"  #error: incorrect Password
				user_ErrorPattern="Client"	#error: Client ($username@$realm1) unknown
				user_ErrorPattern1="unknown"
			
				val1=`echo $ERR| grep -s $passwd_ErrorPattern`   #incorrect Password,KRBv5 Err no.24 
				val11=`echo $ERR | grep -s $user_ErrorPattern | grep -s $user_ErrorPattern1` 
				#Client ($username@$realm1) unknown,KRBv5 Err no.6
				if [ x"$val1" != x""  -o x"$val11" != x"" ];
				then
					echo "TA_EMAIL Logging starts here...\n"
					${SAMBA_BIN}/alnetmsglog log 812A &
					${SAMBA_BIN}/alnetmsglog notify 812A &
					#To avoid Account lockout case:Bypass MFP to Share-level,without trying for Domain Join.
					#Returning the error no.6 as per Kerberos v5 library error code table.
					return $KRB5KDC_ERR_PREAUTH_FAILED  
				else
					echo "No logging Required...1"
				fi

				time_ErrorPattern1="negative"
				time_ErrorPattern2="lifetime" 	#error: Requested effective lifetime is negative
				val2=`echo $ERR|grep -s $time_ErrorPattern1|grep -s $time_ErrorPattern2` 
				#Requested effective lifetime is negative
				if [ x"$val2" != x"" ];then
					echo "TA_EMAIL Logging starts here...\n"
					${SAMBA_BIN}/alnetmsglog log 8128 &
					${SAMBA_BIN}/alnetmsglog notify 8128 &
					return 1
				else
					echo "No logging Required...2"
				fi 
				
				realm_ErrorPattern1="unable "
				realm_ErrorPattern2=" KDC " #error:unable to reach any KDC in realm $realm_name
				val3=`echo $ERR|grep -s $realm_ErrorPattern1|grep -s $realm_ErrorPattern2`
														  #unable to reach any KDC in realm $realm_name
				if [ x"$val3" != x"" ];then
					echo "TA_EMAIL Logging starts here...\n"
					${SAMBA_BIN}/alnetmsglog log 812B &
					${SAMBA_BIN}/alnetmsglog notify 812B &
					return 1
				else
					echo "No logging Required...3"
				fi
		
							realm_ErrorPattern3="Wrong "
							realm_ErrorPattern4="realm" #error:Wrong realm
							val5=`echo $ERR|grep -s $realm_ErrorPattern3|grep -s $realm_ErrorPattern4`
														  #Wrong realm
							if [ x"$val5" != x"" ];then
					 ##Returning the error no.144 as  per Kerberos v5 library error code table.
									return $KRB5KRB_AP_WRONG_PRINC
				fi

				# Kdestroy removed before kinit command
				tExpire_ErrorPattern1="skew "
				tExpire_ErrorPattern2=" great" # Clock skew too great
				val4=`echo $ERR|grep -s $tExpire_ErrorPattern1|grep -s $tExpire_ErrorPattern1`
				#kinit: krb5_get_init_creds: Clock skew too great
							if [ x"$val4" != x"" ];then
					echo "TA_EMAIL Logging starts here...\n"
					${SAMBA_BIN}/alnetmsglog log 8129 &
					${SAMBA_BIN}/alnetmsglog notify 8129 &
					kdestroy  #destroy the existing ticket and Get the new TGT from server .
					continue
					#return 0
				else
					echo "No logging Required...4"
				fi
				((iter=iter+1))
			else
				echo "breaking after trying 10 times"
				sleep 1
				return 1
			fi
		else 
			#echo "Primary authentication failed"
			#return 0
			#exit 1
			#else
			#echo -n "kinit is successfull"
			echo "net ads join ....."
			echo "Temproaory file Created and will be deleted: $KERBEROS_STATUS"
			DOMAIN_NNAME=`grep "realm" ${SMB_CONF_FILE} | awk -F"=" '{ print $2 }'`
			${SAMBA_BIN}/net ads join -U$UP  -s ${SAMBA_CONF_DIR}/smb.conf 2>&1 | tee  ${KERBEROS_STATUS}
			ret_ads=`cat ${KERBEROS_STATUS} | grep "Joined" | awk -F "'" '{ print $4 }' | tr "[:lower:]" "[:upper:]"` > /dev/null
			unlink ${KERBEROS_STATUS}
			echo "Joining to domain=$ret_ads, Actual domain=$DOMAIN_NNAME"
			if [ x"$ret_ads" == x"$DOMAIN_NNAME" ];then
				echo "AD joined success, setting $DOMAIN_NNAME for Panel Display"
				${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/currentStatus ${DOMAIN_NNAME}&
				${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/adsName ads &
				return 0
			else
				echo "AD joined failed"
				return 1
			fi	
		fi
		#echo "EXITING ADJOIN() =$ret_ads"
		#return $ret_ads
	done
}


