                echo "Set samba as share as Domain Join will also fail."
                set_samba_as_share
                ${SAMBA_BIN}/alnetmsglog setxpathandnotify Network/Status/SMB "CAN'T CONNECT TO THE DOMAIN"&
            else
            if [ x"$ret_m" != x"0" ] ; then
                JOINED_AD_DOMAIN=0
                echo "AD-Join failed, try joining NT domain"
                sed -i -e '/client NTLMv2 auth=/ c\client NTLMv2 auth=Yes' ${SAMBA_CONF_DIR}/smb.conf
                #set date back to the original
                #date -s "$org_date"
                echo "ret_m after AD join()"$ret_m
                domain_join $1 $2 $3 $4 $5
                ret_m=$?
                if [ x"$ret_m" != x"0" ] ; then
                    echo "NT Domain-Join failed too, set samba as share"
                    set_samba_as_share
                    ${SAMBA_BIN}/alnetmsglog setxpathandnotify Network/Status/SMB "CAN'T CONNECT TO THE DOMAIN"&
                else
                    echo "Successfullt joined NT domain"
                    ${SAMBA_BIN}/alnetmsglog setxpathandnotify Network/Status/SMB ""&
                fi
            else
                JOINED_AD_DOMAIN=1;
                echo "Successfully joined AD domain"
                ${SAMBA_BIN}/alnetmsglog setxpathandnotify Network/Status/SMB ""&
            fi
        fi
        else
            ${SAMBA_BIN}/alnetmsglog setxpathandnotify Network/Status/SMB ""&
            sed -i -e '/map to guest=/ c\map to guest=bad user' ${SAMBA_CONF_DIR}/smb.conf
        fi
        ;;
        6)
        echo "Guest Logon Disabled..."
        ${SAMBA_BIN}/alnetmsglog setxpath Network/Status/SMB ""&
        sed -i -e '/map to guest=/ c\map to guest=never' ${SAMBA_CONF_DIR}/smb.conf
        sed -i -e '/guest only=/ c\guest only=yes' ${SAMBA_CONF_DIR}/smb.conf
        DOMAIN_NNAME=`grep "workgroup" ${SMB_CONF_FILE} | awk -F"=" '{ print $2 }'`
        echo "Status-------> Writing workgroup info for share $DOMAIN_NNAME to panel for level 6"
        ${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/currentStatus ${DOMAIN_NNAME}&
        ${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/adsName workgroup &
        echo "adding user to smbpasswd file.."
        if [ -z $3 ] || [ -z $4 ];then
                echo "No username and password argument is supplied"
                return 1
        else
                GuestUsername=`echo $3|cut -c3-`
                GuestPassword=`echo $4|cut -c3-`
                if [ -z $GuestUsername ];then
                        echo "Username is empty, guest logon cannot be disabled."
                        return 1
                else
                        #default passdb backends require the user to already exist in the system password file (usually /etc/passwd),
                        #else the request to add the user will fail. so adding user to /etc/passwd file without creating home directory for that user
                        useradd -u 9999 -M $GuestUsername
                        #adding user to smbpasswd file.(If usert already exists then it will considered as password change request.
                        echo -e "$GuestPassword\n$GuestPassword" | ${SAMBA_BIN}/smbpasswd -a -s $GuestUsername
                fi
        fi
        ;;

	0)
		#if [ $domainJoin -eq 0 ];then
		#case 0->WorkGroup
		echo "WorkGroup Level in Progress. ...."
		${SAMBA_BIN}/alnetmsglog setxpathandnotify Network/Status/SMB ""&
		sed -i -e '/map to guest=/ c\map to guest=bad user' ${SAMBA_CONF_DIR}/smb.conf        
		DOMAIN_NNAME=`grep "workgroup" ${SMB_CONF_FILE} | awk -F"=" '{ print $2 }'`
		echo "Status-------> Writing workgroup info for share $DOMAIN_NNAME to panel for level 0"
		${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/currentStatus ${DOMAIN_NNAME}&
		${SAMBA_BIN}/alnetmsglog setxpath Network/Protocols/SMB/adsName workgroup &
	;;
	esac

	start_samba

	#15102015: HDD Access:
	#Samba logging will start if service is restarted in sleep mode.
	# To avoid this check the shared memory value of SHM_NET_PM_LOGGING
	# and if value is 0 execute smbcontrol command to stop logging else don't do anything
	${EB2}/bin/shmemutil SHM_NET_PM_LOGGING getint
	MFPSLEEP_VAL=$?
	if [ $MFPSLEEP_VAL == "0" ]; then
		sleep 1 # sleep here because all 3 processes were not ready immediate after start(2-smbd and 1-nmbd)
		#echo "MFP is in sleep state and samba service is restarted, don't do samba logging"
		smbcontrol all debug 0
	fi

	#20171406: Feedback from L6.022/L6.032FC: restart samba incase smb ports are not listening
	PRIPORTSTATE=`netstat -plan | grep smbd | awk -v i=1 -v j=4 'FNR == i {print $j}'`
        PRIMARY_PORT=0.0.0.0:139
        PORTCOUNT=0
        while [ x"$PRIPORTSTATE" != x"$PRIMARY_PORT" ]
        do
		netstat -plan | grep smbd
		if test $PORTCOUNT -le 5
		then
			PRIPORTSTATE=`netstat -plan | grep smbd | awk -v i=1 -v j=4 'FNR == i {print $j}'`
			if [ x"$PRIPORTSTATE" != x"$PRIMARY_PORT" ]; then
				echo -n "restarting samba at port listen failure....."
				killall -v smbd
                        	${SAMBA_BIN}/smbd -s ${SAMBA_CONF_DIR}/smb.conf -D
                        	((PORTCOUNT=PORTCOUNT+1))
				sleep 5 # sleep untill netstat displays ports
			else
				break
			fi
		else
			echo -n "samba port: 5 counts are done....."
			netstat -plan | grep smbd
			break
		fi
	done

	#Manoj 20100913 Addind support for panel display of samba current status
	#LINK_SAMBA_PID=`ps -elf | grep -i alSambaLinkCheck |  grep -v grep | awk '{print $4}'`
	#if [ -z $LINK_SAMBA_PID ]; then
	#	echo "Starting samba link check"
	#	${SAMBA_BIN}/alSambaLinkCheck &
	#fi
	echo 
	;;
'stop')
	echo -n "stopping samba ..."
	killall -v smbd
	killall -v nmbd
#	killall -v winbindd
	COUNT=0 
	PID=`pidof -s smbd`
	while [ "$PID" != "" ] 
	do
		if test $COUNT -le 10 
		then
			echo "$COUNT Waiting for smbd shutdown in Stop"
			PID=`pidof -s smbd`
			if [ $PID ]; then
				killall -v smbd
				killall -v nmbd
			#	killall -v winbindd
				((COUNT=COUNT+1))
				sleep 1
			fi
		else
			break	
		fi
	done
	echo "Killing samba force -9"
	killall -9 -v smbd
	killall -9 -v nmbd
#	killall -9 -v winbindd	
	RETVAL=$?
	#Manoj 20100913 Addind support for panel display of samba current status
	#LINK_SAMBA_PID=`ps -elf | grep -i alSambaLinkCheck |  grep -v grep | awk '{print $4}'`
	#if [ $LINK_SAMBA_PID ]; then
	#	echo "Killing samba link check"
	#	killall alSambaLinkCheck
	#fi
	echo
	;;
'restart'|'reload')
	$0 stop
	$0 start $2 $3 $4 $5
	RETVAL=$?
	;;
'status')
	RETVAL=0
	PID=`pidof -s smbd`
	if [ $PID ]; then
		RETVAL=1
		echo "running"
	else
		echo "stopped"
	fi
	;;
	
  *)
	echo "Usage: smb {start|stop|restart|status} -a{1} -u{user} -p{pass}"
	exit 1
esac

exit $RETVAL
